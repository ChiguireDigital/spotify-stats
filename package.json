{
  "name": "spotify-stats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --dns-result-order=ipv4first --watch server/src/index.js",
    "start:server": "node --dns-result-order=ipv4first server/src/index.js",
    "db:migrate": "node server/src/scripts/migrate.js",
    "test": "node --test server/test/*.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-session": "latest",
    "mysql2": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "latest"
  }
}

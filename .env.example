VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
VITE_API_BASE_URL=http://127.0.0.1:3001

# Backend local
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=spotify_stats
MYSQL_USER=root
MYSQL_PASSWORD=

# Spotify OAuth del backend
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/callback
SESSION_SECRET=cambia-esta-clave-local

# Chatbot (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Seguridad (recomendado): clave para cifrar tokens de Spotify en BD (32 bytes base64/hex o una frase larga)
TOKEN_ENCRYPTION_KEY=
